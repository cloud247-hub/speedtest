{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nettfart",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // En test gir ~150 forespørsler (ping + biter av data). Logg bare et utvalg, så gratiskvoten for logger holder.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
